<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Revolution Idle</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\src\WsConnection.cs" Link="WsConnection.cs" />
    <Compile Include="..\src\BridgePackets.cs" Link="BridgePackets.cs" />
    <Compile Include="..\src\StatePayload.cs" Link="StatePayload.cs" />
    <Compile Include="..\src\ExtraRoots.cs" Link="ExtraRoots.cs" />
    <Compile Include="..\src\Plugin.cs" Link="Plugin.cs" />
    <Compile Include="..\src\KeyboardInput.cs" Link="KeyboardInput.cs" />
    <Compile Include="..\src\UnityUiClickDispatcher.cs" Link="UnityUiClickDispatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\protocol\fixtures\bridge-packets.json"
          Link="protocol\bridge-packets.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\protocol\fixtures\test-request.json"
          Link="protocol\test-request.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.UI.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
