<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Revolution Idle</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\src\HttpScoreServer.cs" Link="HttpScoreServer.cs" />
    <Compile Include="..\src\StatePayload.cs" Link="StatePayload.cs" />
    <Compile Include="..\src\Plugin.cs" Link="Plugin.cs" />
    <Compile Include="..\src\InputBridgeProtocol.cs" Link="InputBridgeProtocol.cs" />
    <Compile Include="..\src\ClickCommandQueue.cs" Link="ClickCommandQueue.cs" />
    <Compile Include="..\src\Win32InputBridge.cs" Link="Win32InputBridge.cs" />
    <Compile Include="..\src\UnityUiClickDispatcher.cs" Link="UnityUiClickDispatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.UI.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
